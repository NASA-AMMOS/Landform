{
  "extends": "airbnb",
  "env": {
    "node": true,
    "browser": true,
    "es6": true,
    "jest": true
  },
  "plugins": ["@jpl/eslint-plugin-compact-brace-style"],
  "rules": {

    //allow JSX anywhere, not just in .jsx files
    //normally we just put jsx in .js files now
    //https://github.com/facebookincubator/create-react-app/issues/87#issuecomment-234627904
    "react/jsx-filename-extension": ["off"],

    "react/jsx-tag-spacing": ["error", {"beforeSelfClosing": "allow"}],

    "react/prop-types": ["off"],
    "react/jsx-first-prop-new-line": ["off"],
    "react/jsx-max-props-per-line": ["off"],

    "jsx-a11y/anchor-is-valid": [
      "error",
      {
        "components": [ "Link" ],
        "specialLink": [ "to", "hrefLeft", "hrefRight" ],
        "aspects": [ "noHref", "invalidHref", "preferButton" ]
      }
    ],
    
    //allow function parameters to either align with first or be indented
    "indent": [
      "error",
      2,
      {
        "SwitchCase": 1,
        //TODO https://github.com/eslint/eslint/issues/9383
        //"MemberExpression": "first",
        "FunctionDeclaration": { "parameters": "off" },
        "FunctionExpression": { "parameters": "off" },
        "CallExpression": { "arguments": "off" },
        "ignoredNodes": [ "JSXElement", "JSXElement *" ]
      }
    ],

    "brace-style": ["off"],
    "@jpl/compact-brace-style/brace-style": ["error", "1tbs", { "allowSingleLine": true, "allowClausePerLine": true }],

    "arrow-body-style": [
      "error",
      "as-needed",
      { "requireReturnForObjectLiteral": true }
    ],
    
    "key-spacing": [
      "error",
      { "beforeColon": false, "afterColon": true, "mode": "minimum" }
    ],
    
    "object-curly-newline": [
      "error",
      { "multiline": true, "consistent": true }
    ],

    "no-inner-declarations": ["off"],
    "space-before-function-paren": ["error", "never"],
    "max-len": ["off"],
    "linebreak-style": ["off"],
    "func-names": ["off"],
    "no-console": ["off"],
    "class-methods-use-this": ["off"],
    "no-plusplus": ["off"],
    "no-case-declarations": ["off"],
    "no-underscore-dangle": ["off"],
    "import/prefer-default-export": ["off"],
    "import/no-absolute-path": ["off"],
    "import/no-extraneous-dependencies": ["off"],
    "import/extensions": ["off"],
    "import/no-unresolved": ["off"],
    "no-empty": ["off"],
    "padded-blocks": ["off"],
    "arrow-parens": ["off"],
    "function-paren-newline": ["off"],
    "object-property-newline": ["off"],
    "newline-per-chained-call": ["off"],
    "wrap-iife": [ "error", "inside" ],
    "no-mixed-operators": ["off"],
    "no-param-reassign": ["off"],
    "radix": ["off"],
    "prefer-destructuring": ["off"],
    "no-continue": ["off"],
    "no-multi-assign": ["off"],
    "spaced-comment": ["off"],
    "no-prototype-builtins": ["off"],
    "no-multi-spaces": ["off"],
    "prefer-template": ["off"],
    "no-return-assign": ["off"],
    "one-var-declaration-per-line": ["off"],
    "one-var": ["off"],
    "no-nested-ternary": ["off"],
    "no-await-in-loop": ["off"],
    "yoda": ["off"],
    "no-useless-escape": ["off"],

    //function definitions are always hoisted, so it's safe to use them before they're lexically defined
    //classes are not
    //the "variables" option here is confusing - it's really about variables defined in *enclosing scopes*
    "no-use-before-define": ["error", { "functions": false, "classes": true, "variables": false }],

    //the next rule is to override airbnb's decision to outlaw for..of looops
    //(note we are keeping the decision to outlaw for..in loops)
    //they seem to think you can replace them with forEach()
    //but that does not work e.g. if you want to have a yield or break in the loop body
    //unfortunately there is no way to just re-enable one pice of syntax
    //we need to repeat their whole rule here
    //https://github.com/airbnb/javascript/issues/1271
    "no-restricted-syntax": [
      "error", 
      { "selector": "ForInStatement" },
      { "message": "for..in loops iterate over the entire prototype chain, which is virtually never what you want. Use Object.{keys,values,entries}, and iterate over the resulting array." },
//      { "selector": "ForOfStatement" },
//      { "message": "iterators/generators require regenerator-runtime, which is too heavyweight for this guide to allow them. Separately, loops should be avoided in favor of array iterations." },
      { "selector": "LabeledStatement" },
      { "message": "Labels are a form of GOTO; using them makes code confusing and hard to maintain and understand." },
      { "selector": "WithStatement" },
      { "message": "`with` is disallowed in strict mode because it makes code impossible to predict and optimize." }
    ]
  }
}
