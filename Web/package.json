{
  "name": "landformweb",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "server.js",
  "scripts": {
    "postinstall": "node tools/npmInstallClient.js",
    "start": "concurrently --kill-others \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "node tools/startClient.js",
    "worker": "node tools/startWorker.js",
    "make-token": "node tools/makeToken.js",
    "tests": "node tools/runTests.js",
    "configure-backend": "node tools/configureBackend.js",
    "git-archive": "git archive -o landform-master.zip --format=zip HEAD",
    "bundle-master": "npm run git-archive && node tools/bundleClient.js --overwrite && node tools/bundleMaster.js --overwrite ",
    "build-client": "node tools/buildClient.js",
    "build": "npm install && npm run build-client && npm run bundle-master",
    "bundle-worker": "node tools/bundleWorker.js --overwrite",
    "deploy": "node tools/deploy.js",
    "local-deploy": "node tools/localDeploy.js",
    "delete-queues": "node tools/deleteQueues.js",
    "show-config": "node tools/showConfig.js"
  },
  "keywords": [
    "landform"
  ],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=8"
  },
  "dependencies": {
    "aws-sdk": "^2.315.0",
    "body-parser": "^1.18.2",
    "byline": "^5.0.0",
    "cookie-parser": "^1.4.3",
    "cors": "^2.8.4",
    "express": "^4.16.2",
    "express-session": "^1.15.6",
    "fs-extra": "^7.0.0",
    "guid": "0.0.12",
    "jsonwebtoken": "^8.1.0",
    "ldapjs": "^1.0.2",
    "memorystore": "^1.6.0",
    "multer": "^1.3.1",
    "ldapauth-fork": "^4.3.0",
    "passport": "^0.4.1",
    "passport-ldapauth": "^2.1.3",
    "passport-saml": "^1.3.3",
    "winston": "^3.1.0",
    "winston-daily-rotate-file": "^3.3.2",
    "xml2js": "^0.4.19"
  },
  "devDependencies": {
    "@jpl/adm-zip": "^0.4.15",
    "@jpl/eslint-plugin-compact-brace-style": "^0.0.1",
    "concurrently": "^3.6.1",
    "eslint": "^4.14.0",
    "eslint-config-airbnb": "^16.1.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-jsx-a11y": "^6.1.1",
    "eslint-plugin-react": "^7.11.1",
    "json-parse-better-errors": "^1.0.2",
    "newman": "^4.6.0",
    "strip-json-comments": "^2.0.1"
  }
}
