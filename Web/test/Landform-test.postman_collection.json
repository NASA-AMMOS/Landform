		{
			"name": "get project result URL",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "0b544f40-839a-4f3e-a602-247169cc72b7",
						"type": "text/javascript",
						"exec": [
							"pm.test(\"HTTP OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"response is json\", function () {",
							"    pm.response.to.have.jsonBody();",
							"});",
							"",
							"pm.test(\"body is correct\", function () {",
							"    pm.response.to.have.body(new RegExp(`https://.+[.]s3[.]amazonaws[.]com/.+/www/${pm.variables.get('PROJECT_NAME')}/tileset.json`));",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "x-landform-token",
						"value": "{{API_TOKEN}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": ""
				},
				"url": {
					"raw": "{{SERVER_URL}}/api/projects/{{PROJECT_NAME}}/result?redirect=false",
					"host": [
						"{{SERVER_URL}}"
					],
