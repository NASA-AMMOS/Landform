		{
			"name": "get project result URL",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "d0df6d5f-5537-44d3-9248-e67829270b8e",
						"type": "text/javascript",
						"exec": [
							"pm.test(\"HTTP OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"content type\", function () {",
							"    pm.response.to.have.header(\"Content-Type\");",
							"    pm.response.to.be.header(\"Content-Type\", \"text/plain; charset=utf-8\");",
							"});",
							"",
							"pm.test(\"body is correct\", function () {",
							"    pm.response.to.have.body(new RegExp(`https://.+[.]s3[.]amazonaws[.]com/.+/www/${pm.variables.get('PROJECT_NAME')}/tileset.json`));",
							"});"
						]
					}
				}
			],
