					"listen": "test",
					"script": {
						"id": "7d55dd73-6c05-4aa9-b0f4-3de0f2dfb300",
						"type": "text/javascript",
						"exec": [
							"pm.test(\"HTTP OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"response is json\", function () {",
							"    pm.response.to.have.jsonBody();",
							"});",
							"",
							"pm.test(\"task running\", function () {",
							"    pm.expect(pm.response.json().running).to.eql(true);",
							"});"
						]
					}
				}
			],
