	"item": [
		{
			"name": "get master task ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "c0233a7a-a299-4ff0-8cdd-243397583695",
						"type": "text/javascript",
						"exec": [
							"pm.test(\"HTTP OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"response is json\", function () {",
							"    pm.response.to.have.jsonBody();",
							"});",
							"",
							"pm.test(\"body is correct\", function () {",
							"    pm.response.to.have.body(new RegExp('[0-9]+'));",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "x-landform-token",
						"value": "{{API_TOKEN}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": ""
				},
				"url": {
					"raw": "{{SERVER_URL}}/api/tasks/master/id",
					"host": [
						"{{SERVER_URL}}"
					],
					"path": [
						"api",
						"tasks",
						"master",
						"id"
					]
				}
			},
			"response": []
		},
		{
			"name": "get master task status",
			"event": [
