{
	"info": {
		"_postman_id": "7b66a6a7-d741-42ae-b7ab-cc4b73b1cccc",
		"name": "Landform-poll",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "poll project metadata",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "6e977225-4dc7-4322-9467-baac0be5c4b6",
						"exec": [
							"pm.test(\"HTTP OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"response is json\", function () {",
							"    pm.response.to.have.jsonBody();",
							"});",
							"",
							"const md = pm.response.json();",
							"postman.setNextRequest(md && md.Project && md.Project.FinishedRunning ? null : \"poll project metadata\");"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "x-landform-token",
						"value": "{{API_TOKEN}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": ""
				},
				"url": {
					"raw": "{{SERVER_URL}}/api/projects/{{PROJECT_NAME}}",
					"host": [
						"{{SERVER_URL}}"
					],
					"path": [
						"api",
						"projects",
						"{{PROJECT_NAME}}"
					]
				}
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"id": "611673cd-f3b1-420f-99fc-b30f7896a3dd",
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"id": "a4e11f89-b018-4f2a-b20e-e7fb3d881745",
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	]
}